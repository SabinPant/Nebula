# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build Outputs ────────────────────────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.output/

# ─── Environment Variables (NEVER commit these) ───────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging

# ─── Prisma ───────────────────────────────────────────────────────────────────
prisma/migrations/migration_lock.toml
**/node_modules/.prisma/
**/src/generated/

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Testing ──────────────────────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ─── Cache ────────────────────────────────────────────────────────────────────
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
*.tsbuildinfo

# ─── OS Files ─────────────────────────────────────────────────────────────────
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# ─── IDEs & Editors ───────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
# Keep these two so teammates get the same editor config
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Docker ───────────────────────────────────────────────────────────────────
# Don't ignore docker-compose.yml — that gets committed
# But ignore any local override files
docker-compose.override.yml

# ─── Uploads & Generated Files ────────────────────────────────────────────────
uploads/
public/uploads/
*.pem
*.key
*.cert
*.p12

# ─── Package Manager Locks ────────────────────────────────────────────────────
# Commit package-lock.json (keeps versions consistent)
# Ignore yarn and pnpm locks if you're using npm
yarn.lock
pnpm-lock.yaml

# ─── Misc ─────────────────────────────────────────────────────────────────────
*.local
.temp/
tmp/