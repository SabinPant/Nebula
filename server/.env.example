# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://nebula_user:nebula_pass@localhost:5432/nebula_dev"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="generate-a-64-char-random-string-here"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_SECRET="generate-a-different-64-char-random-string-here"
JWT_REFRESH_EXPIRY="7d"

# ─── Server ───────────────────────────────────────────────────────────────────
APP_PORT=3001
NODE_ENV="development"
NEPAL_TIMEZONE="Asia/Kathmandu"

# ─── External APIs ────────────────────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key-here"
ENGINE_HTTP_URL="http://localhost:3003"
ENGINE_WS_URL="ws://localhost:3002"
ENGINE_HEALTH_CHECK_INTERVAL_MS=5000

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# ─── SMTP ─────────────────────────────────────────────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@nebula.com"

# ─── Limits ───────────────────────────────────────────────────────────────────
WEEKLY_TOPUP_CAP_PAISE=50000000

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"